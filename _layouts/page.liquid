---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      <span class="float-right">
        {% if page.github_repo %}
          <a
            href="{{ page.github_repo }}"
            target="_blank"
            rel="noopener noreferrer"
            title="GitHub Repository"
            class="ml-2"
          >
            <i class="fa-brands fa-github"></i>
          </a>
        {% endif %}

        {% if page.report_pdf %}
          <a
            {% if page.report_pdf contains '://' %}
              href="{{ page.report_pdf }}"
            {% else %}
              href="{{ page.report_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            title="Final Report"
            class="ml-2"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
        
        {% if page.poster_pdf %}
          <a
            {% if page.poster_pdf contains '://' %}
              href="{{ page.poster_pdf }}"
            {% else %}
              href="{{ page.poster_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            title="Poster"
            class="ml-2"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}

        {% if page.presentation_pdf %}
          <a
            {% if page.presentation_pdf contains '://' %}
              href="{{ page.presentation_pdf }}"
            {% else %}
              href="{{ page.presentation_pdf | prepend: 'assets/pdf/' | relative_url }}"
            {% endif %}
            target="_blank"
            rel="noopener noreferrer"
            title="Poster"
            class="ml-2"
          >
            <i class="fa-solid fa-file-pdf"></i>
          </a>
        {% endif %}
      </span>
    </h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
